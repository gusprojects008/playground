function Calculo() {
    this.operacao = function (num1, num2, operador, decimal) {
        operador = operador ? operador : "+";
        decimal = decimal ? decimal : 2;

        if (isNaN(num1) == true) {
            num1 = this.converteMonetario(num1); //new Number( replaceAll( replaceAll( num1, ".", "" ), ",", ".") );
