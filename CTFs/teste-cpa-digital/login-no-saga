.positive-loader {
    position: relative;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 9999999;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    width: 100%;
    height: 100%;
    padding: 20px;
    font-size: 26px;
    text-align: center;
    list-style: none;
    -webkit-justify-content: center;
    -ms-flex-pack: center;
    justify-content: center;
    -webkit-align-items: center;
    -ms-flex-align: center;
    align-items: center;
    -webkit-flex-direction: column;
    -ms-flex-direction: column;
    flex-direction: column;
    background: hsla(0, 0%, 100%, 0.85)
}

.positive-loader.fill-in-page {
    top: 2px;
    position: fixed
}

.positive-loader .loader,
.positive-loader .loader .loader-container {
    position: relative
}

.positive-loader .loader .spinner-container {
    width: 55px;
    height: 55px;
    position: relative;
    margin: auto;
    transition: opacity .5s ease-out;
    transition-delay: .5s
}

.positive-loader p {
    width: 100%;
    margin: 20px 0 40px;
    font-size: .8em
}

.loader .spinner {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    padding: 5%;
    text-align: center
}

.loader .spinner .message {
    display: inline-block;
    margin-top: 20px;
    font-size: 14px;
    color: #5c5c5c;
    opacity: 1;
    transition: opacity .5s ease-out
}

.loader .loader-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%
}

.loader .loader-container.complete {
    background-color: #fff;
    transition: all 1s ease-out;
    transition-delay: .5s
}

.loader .circle-container {
    position: relative;
    width: 50px;
    margin: 0 auto;
    text-align: center;
    opacity: 1;
    transition: opacity .5s ease-out;
    transition-delay: .5s
}

.loader .circle-container:before {
    display: block;
    padding-top: 100%;
    content: ""
}

.loader .complete .circle-container,
.loader .complete .message {
    opacity: 0
}

.loader .circle {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100%;
    margin: auto;
    -webkit-transform-origin: center center;
    transform-origin: center center;
    -webkit-animation: rotate 2s linear infinite;
    animation: rotate 2s linear infinite
}

.loader .path {
    stroke-dasharray: 1, 200;
    stroke-dashoffset: 0;
    stroke-linecap: round
}

.loader:not(.negative) .path {
    -webkit-animation: dash 1s ease-in-out infinite, color 4s ease-in-out infinite;
    animation: dash 1s ease-in-out infinite, color 4s ease-in-out infinite
}


