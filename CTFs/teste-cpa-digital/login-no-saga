 * Se campo for vazio entÃ£o ele gerarÃ¡ um array contendo todos os campos do objeto no registro
 * separador de campo padrÃ£o '#'
 * separador de registro padrÃ£o ','
 *
 * @param string campo
 * @param string separadorReg
 * @param string separadorCampo
 * @return string
 */
Array.prototype.objectToString = function (campo, separadorReg, separadorCampo) {
    var string = '';
    sepReg = separadorReg ? separadorReg : ',';
    sepCampo = separadorCampo ? separadorCampo : '#';
    for (var i = 0; i < this.length; i++) {
        if (campo) {
            string += this[i][campo];
        }
        else {
            for (var j in this[i]) {
                string += this[i][j] + sepCampo;
            }
            string = string.substr(0, string.length - 1);//Eliminar o Ãºltimo separador de campo
        }
        string += sepReg;
    }
    string = string.substr(0, string.length - 1);//Elimina o Ãºltimo separador de registro
    return string;
}

