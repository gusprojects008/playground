function trim(valor) {
  valor += '';
  for (i = 0; i < valor.length; i++) {
      if (valor.substr(i, 1) != " ") {
      valor = valor.substr(i);
      break;
  }
  if (i == valor.length - 1) {
      valor = "";
      }
  }
  for (i = valor.length - 1; i >= 0; i--) {
      if (valor.substr(i, 1) != " ") {
          valor = valor.substr(0, i + 1);
          break;
      }
  }
  return valor;
}

