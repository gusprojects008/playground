    quantidade = quantidade ? quantidade : 2;
    separador = separador ? separador : ',';

    arValor = valor.split(separador);
    if (arValor[1].length == quantidade) {
        return valor;
    } else {
        arValor[1] = arValor[1].substr(0, quantidade);
        valor = arValor[0] + separador + arValor[1];
        return valor;
    }
}

