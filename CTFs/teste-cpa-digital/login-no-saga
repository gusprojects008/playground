        }

        if (isNaN(num2) == true) {
            num2 = this.converteMonetario(num2); //new Number( replaceAll( replaceAll( num2, ".", "" ), ",", ".") );
        } else {
            num2 = new Number(num2);
        }

        switch (operador) {
            case '+':
                return (num1 + num2).toFixed(decimal);
                break;
            case '-':
                return (num1 - num2).toFixed(decimal);
                break;
            case '*':
                return (num1 * num2).toFixed(decimal);
                break;
            case '/':
                return (num1 / num2).toFixed(decimal);
                break;
        }
        alert('A funÃ§Ã£o "operacao" nÃ£o contempla AINDA o operador aritmÃ©tico escolhido.');
    }

    this.comparar = function (num1, num2, operador) {
        operador = operador ? operador : '>';

//		num1 = this.converteMonetario(num1); //new Number( replaceAll( replaceAll( num1, ".", "" ), ",", ".") );
//		num2 = this.converteMonetario(num2); //new Number( replaceAll( replaceAll( num2, ".", "" ), ",", ".") );
        if (isNaN(num1) == true) {
            num1 = this.converteMonetario(num1); //new Number( replaceAll( replaceAll( num1, ".", "" ), ",", ".") );
        } else {
            num1 = new Number(num1);
        }

        if (isNaN(num2) == true) {
            num2 = this.converteMonetario(num2); //new Number( replaceAll( replaceAll( num2, ".", "" ), ",", ".") );
        } else {
            num2 = new Number(num2);
        }

        switch (operador) {
            case '>':
                return (num1 > num2);
                break;
            case '>=':
                return (num1 >= num2);
                break;
            case '<':
                return (num1 < num2);
                break;
            case '<=':
                return (num1 <= num2);
                break;
            case '=':
                return (num1.valueOf() == num2.valueOf());
                break;
        }
        alert('A funÃ§Ã£o "comparar" nÃ£o contempla AINDA o operador lÃ³gico escolhido.');

    }

    this.converteMonetario = function (num) {
        return new Number(replaceAll(replaceAll(num, ".", ""), ",", "."));
    }

    this.retiraZeroEsquerda = function (num) {
        num = new String(replaceAll(replaceAll(num, ".", ""), ",", ""));

        return new Number(num);
    }

    /* FunÃ§Ã£o para subustituir todos
     * descscricao 	:
     * author 		: Alexandre Dourado
     * parametros 	:
     */
    function replaceAll(str, de, para) {
        var pos = str.indexOf(de);
        while (pos > -1) {
            str = str.replace(de, para);
            pos = str.indexOf(de);
        }
        return (str);
    }

}

/*
 * Classe   Data
 * O obj Data possibilita operaÃ§Ãµes aritimÃ©ticas (Adicionar dias) e lÃ³gicas em datas no formato Brasileiro (DD/MM/YYYY).
 *
 * @author  Felipe Tarchiani CerÃ­volo Chiavicatti
