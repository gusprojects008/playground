    cnpj = cnpj.replace(/[^0-9]/ig, '');
    if (cnpj.length != 14)
        return false;

    if (cnpj.length != 14)
        return false;

    var dv = false;
    var cnpj_dv = cnpj.substr(12, 2);

    var digito = 0;
    var controle = '';

    for (var i = 0; i < 2; i++) {
        var soma = 0;
        for (var j = 0; j < 12; j++)
            soma += cnpj.substr(j, 1) * ((11 + i - j) % 8 + 2);

        if (i == 1)
            soma += digito * 2;

        digito = 11 - soma % 11;

        if (digito > 9)
            digito = 0;

        controle += digito + '';
    }

    return controle == cnpj_dv;
}

