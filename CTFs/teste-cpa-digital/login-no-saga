		var strCPF 		= jQuery.trim( valueCampo );
		strCPF 			= strCPF.replace(/[^\d]+/g,'');

	    var Soma;
	    var Resto;
	    Soma = 0;

	    if (strCPF == ""){
//	    	msgPadrao.flagMsg = true;
