.q-media {
  position: relative;
  min-width: 230px !important;
  min-height: 40px !important;
  overflow: hidden !important;
  display: flex;
  flex-direction: column;
}
.q-media--player {
  width: 100%;
  height: 100%;
  vertical-align: bottom;
  align-self: flex-end;
}
.q-media--player--bottom-controls--standard {
  height: calc(100vh - 80px);
}
.q-media--player--bottom-controls--dense {
  height: calc(100vh - 40px);
}
.q-media__audio--standard {
  width: 100%;
  height: 80px !important;
  vertical-align: bottom;
  align-self: flex-end;
}
.q-media__audio--dense {
  width: 100%;
  height: 40px !important;
  vertical-align: bottom;
  align-self: flex-end;
}
.q-media__error-window {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  height: 40px;
  font-size: 0.8rem;
  text-align: center;
  color: white;
  background: rgba(255, 0, 0, 0.25);
  transition: height 250ms ease-in;
}
.q-media__overlay-window {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  height: auto;
  background: transparent;
  z-index: 1;
}
.q-media__loading--video {
  position: absolute;
  left: 50%;
  margin-left: -1.5rem;
  top: 50%;
  margin-bottom: -1.5rem;
  width: 3rem;
  height: 3rem;
  color: white;
  background: transparent;
}
.q-media__loading--audio {
  position: absolute;
  left: 50%;
  margin-left: -0.5rem;
  top: 50%;
  margin-bottom: -0.5rem;
  width: 1.5rem;
  height: 1.5rem;
  color: white;
  background: transparent;
}
.q-media--big-button {
  position: absolute;
  left: 50%;
  margin-left: -1.5rem;
  top: 50%;
  margin-bottom: -1.5rem;
  width: 3rem;
  height: 3rem;
  cursor: pointer;
  border-style: solid;
  border-color: white;
  border-width: 1px;
  border-radius: 1.5rem;
  opacity: 1;
  font-size: 3rem;
  z-index: 1000;
  background: rgba(255, 255, 255, 0.28);
}
.q-media--big-button:hover {
  background: rgba(255, 255, 255, 0.15);
}
.q-media--big-button-icon {
  position: relative;
  margin-left: 0.5rem;
  margin-bottom: 2.1rem;
  font-size: 2rem;
}
.q-media__controls {
  position: absolute;
  left: 0;
  bottom: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.4);
  overflow: hidden;
  z-index: 2;
}
.q-media__controls--bottom-controls {
  position: relative !important;
}
.q-media__controls--row {
  height: 40px;
}
.q-media__controls--standard {
  height: 80px !important;
  transition: height 250ms ease-in;
  z-index: 2;
}
.q-media__controls--dense {
  height: 40px !important;
  transition: height 250ms ease-in;
  z-index: 2;
}
.q-media__controls--hidden {
  height: 0 !important;
  transition: height 250ms ease-out;
}
.q-media__controls--button {
  max-width: 40px !important;
  min-width: 40px !important;
  max-height: 40px !important;
  min-height: 40px !important;
}
.q-media__controls--volume-box {
  max-height: 40px !important;
  min-height: 40px !important;
}
.q-media__controls--video-time-text {
  padding: 0 0.25rem;
  color: #fff;
  font-size: 0.8rem;
  text-align: center;
}
.q-media__controls--video-slider {
  padding: 0 4px;
}
.q-media__fullscreen {
  z-index: 5900;
}
.q-media__fullscreen--window {
  position: fixed !important;
  top: 0 !important;
  left: 0 !important;
  height: 100vh !important;
  width: 100vw !important;
  max-height: 100vh !important;
  max-width: 100vw !important;
  overflow: hidden;
}
