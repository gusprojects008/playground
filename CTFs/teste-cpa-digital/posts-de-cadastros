.q-media {
  position: relative;
  min-width: 230px !important;
  min-height: 40px !important;
  overflow: hidden !important;
  display: flex;
  flex-direction: column;
}
.q-media--player {
  width: 100%;
  height: 100%;
  vertical-align: bottom;
  align-self: flex-end;
}
.q-media--player--bottom-controls--standard {
  height: calc(100vh - 80px);
}
.q-media--player--bottom-controls--dense {
  height: calc(100vh - 40px);
}
.q-media__audio--standard {
  width: 100%;
  height: 80px !important;
  vertical-align: bottom;
  align-self: flex-end;
}
.q-media__audio--dense {
  width: 100%;
  height: 40px !important;
  vertical-align: bottom;
  align-self: flex-end;
}
.q-media__error-window {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  height: 40px;
  font-size: 0.8rem;
  text-align: center;
  color: white;
  background: rgba(255, 0, 0, 0.25);
  transition: height 250ms ease-in;
}
.q-media__overlay-window {
  position: absolute;
  left: 0;
  top: 0;
